#!/usr/bin/env bash
# Fails a commit whose staged TOML would fail CI's `taplo fmt --check`.
#
# Only TOML, because it is the one format that kept slipping through: taplo.toml
# aligns value columns, and a comment line or a new key silently needs its whole
# block realigned. Everything else has a formatter on save in VS Code and is
# cheap to fix after the fact; this is the check that was failing CI.
#
# Enable once per clone:   git config core.hooksPath .githooks
# Fix what it reports:     uv run taplo fmt
# Skip it once:            git commit --no-verify
set -euo pipefail

# A loop rather than `mapfile`: macOS ships bash 3.2, which does not have it.
files=()
while IFS= read -r f; do files+=("$f"); done < <(git diff --cached --name-only --diff-filter=ACMR -- '*.toml')
((${#files[@]})) || exit 0

# The staged version is what gets committed, not the working tree's, so check
# that: copy each staged blob into a scratch tree beside a copy of taplo.toml.
root=$(git rev-parse --show-toplevel)
tmp=$(mktemp -d)
trap 'rm -rf "$tmp"' EXIT
cp "$root/taplo.toml" "$tmp/taplo.toml"
for f in "${files[@]}"; do
	mkdir -p "$tmp/$(dirname "$f")"
	git show ":$f" >"$tmp/$f"
done

if ! (cd "$tmp" && uv run --project "$root" taplo fmt --check "${files[@]}" 2>/dev/null); then
	echo "pre-commit: staged TOML is not formatted. Run: uv run taplo fmt && git add -u" >&2
	exit 1
fi
