{
  // Same tools CI runs, so the editor and the pipeline agree. `shellcheck` is the
  // one worth installing even if you never touch shell: it is gated in CI, and the
  // extension flags as you type what `uv run shellcheck` only reports on demand.
  // markdownlint reads the same .markdownlint.json that `uv run rumdl check` does.
  "recommendations": [
    "charliermarsh.ruff",
    "astral-sh.ty",
    "timonwong.shellcheck",
    "DavidAnson.vscode-markdownlint",
    "biomejs.biome",
    "tamasfe.even-better-toml",
    "ms-python.python",
    "redhat.vscode-yaml",
    "samuelcolvin.jinjahtml"
  ]
}
