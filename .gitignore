# macOS
.DS_Store
.AppleDouble
.LSOverride

# Python bytecode
__pycache__/
*.py[cod]
*.pyo

# Virtual environments
.venv/
venv/
env/

# Distribution / packaging
*.egg-info/
dist/
build/

# Pytest / coverage
.pytest_cache/
.coverage
htmlcov/

# Editor / IDE
# `.vscode/*`, not `.vscode/`: git cannot re-include a file whose parent directory is
# excluded, so the trailing-slash form would make the two negations below silently do
# nothing. Everything else in there — launch.json and friends, full of local paths —
# stays ignored.
.vscode/*
!.vscode/extensions.json
.idea/
*.swp
*.swo

# Runtime data
settings.json
*.log
# Deploy webhook output, written next to docker-compose.yml on the cloud VM.
cloud/.deploy.log

# ...but the Claude Code sandbox policy is project config, not runtime data.
# The bare `settings.json` rule above matches at any depth and would swallow it.
# Same for the editor settings, which exist to stop `ruff format` running on save.
# Both negations have to sit *after* that rule: last match wins.
!.claude/settings.json
!.vscode/settings.json

# Deployment secrets. `cloud/.env` is generated on the server by install.sh and holds
# SECRET_KEY, ADMIN_PASSWORD and DEPLOY_SECRET. It is untracked today only by luck —
# one `git add -A` on the VM would publish the production credentials. The template
# beside it, `.env.example`, is a different filename and stays tracked.
.env

# Downloaded assets (fetched by install.sh)
shared/static/js/xterm.min.js
shared/static/css/xterm.min.css

# Meet data (kept locally, not in repo)
~/meet/
/server/BG

# Private documents (legal analysis, not for public repo)
notes/copyright_status.md
server/BG/TestBG.lxf
