# Copy this file to .env and fill in the values before running docker compose.
# This file is tracked; .env is not, which is the point — everything below outlives
# an update that resets the working tree.

# Public domain name Caddy serves and obtains a certificate for.
SPLOUCH_DOMAIN=scores.example.com

# Secret key — generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change_me

# Admin credentials for /admin
ADMIN_USER=admin
ADMIN_PASSWORD=change_me

# Shared secret for the deploy webhook (powers the Update button in /admin)
# Generated automatically by install.sh
DEPLOY_SECRET=change_me

# The control plane's database password. Generated automatically by install.sh.
POSTGRES_PASSWORD=change_me

# The shared secret relay workers present to the control plane. Generated
# automatically by install.sh; every node of one deployment carries the same value.
NODE_SECRET=change_me

# This node, as the control plane's registry and /admin name it
# (docs/architecture/scaling.md).
NODE_NAME=ca1
NODE_REGION=ca
