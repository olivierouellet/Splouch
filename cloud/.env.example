# Copy this file to .env and fill in the values before running docker compose.
# This file is tracked; .env is not, which is the point — everything below outlives
# an update that resets the working tree.

# Public domain name Caddy serves and obtains a certificate for.
SPLOUCH_DOMAIN=scores.example.com

# Secret key — generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change_me

# Admin credentials for /admin
ADMIN_USER=admin
ADMIN_PASSWORD=change_me

# Shared secret for the deploy webhook (powers the Update button in /admin)
# Generated automatically by install.sh
DEPLOY_SECRET=change_me

# The control plane's database password. Generated automatically by install.sh.
POSTGRES_PASSWORD=change_me

# The shared secret relay workers present to the control plane. Generated
# automatically by install.sh; every node of one deployment carries the same value.
NODE_SECRET=change_me

# This node, as the control plane's registry and /admin name it
# (docs/architecture/scaling.md).
NODE_NAME=ca1
NODE_REGION=ca

# This server's parts: any of control, workers, monitoring (docs/cloud.md,
# "Several servers"). Unset: control,workers.
ROLES=control,workers
# A workers-only node: the control plane's address, and the meet list for the back
# link. Unset on a server that runs the control plane.
# CONTROL_URL=https://splouch.org
# PICKER_URL=https://splouch.org/
# 1 on a control plane that workers on other servers reach (opens /internal/* to
# them, still guarded by NODE_SECRET).
REMOTE_NODES=0
# WireGuard (install/scripts/wireguard.sh): this server's address when it is the
# monitoring hub, or the hub's address on a server that sends to it.
# WG_ADDRESS=10.73.0.1
# WG_HUB=10.73.0.1

# Nightly backup of the control plane's store, to /var/backups/splouch on the host.
# Hour (UTC), days kept, and a URL pinged after each good dump (an Uptime Kuma push
# monitor or a healthchecks.io check), so a backup that stops is noticed.
BACKUP_HOUR=03
BACKUP_KEEP=14
BACKUP_PING_URL=

# Relay workers on this node: one per core, minus RESERVED_CORES (Caddy, the control
# plane, Postgres). WORKERS fixes the number instead. Read by cloud_workers.py on
# every deploy.
# WORKERS=
RESERVED_CORES=2

# Monitoring (cloud/monitoring/, docs/cloud.md): Prometheus, Grafana at
# https://<domain>/grafana/, Uptime Kuma, and alerts to Pushover. On when ROLES
# names `monitoring`; MONITORING=1 does the same on a server from before roles.
MONITORING=0
# Generated by install.sh. Grafana's admin password (user `admin`).
GRAFANA_PASSWORD=change_me
# Pushover application token and user key, for the alerts.
PUSHOVER_TOKEN=
PUSHOVER_USER=
# A healthchecks.io check URL; pinged every minute while monitoring is up.
HEALTHCHECKS_URL=
# Uptime Kuma's public status page — set only after creating Kuma's admin account.
STATUS_DOMAIN=

# Who answers for /privacy (docs/cloud.md, "Privacy policy"). Both are needed: the
# policy names the operator and gives the contact address.
PRIVACY_OPERATOR=
PRIVACY_CONTACT=

# QR-code hand-off (docs/cloud.md, "Letting a QR code open the app"). The SHA-256
# of the Android *app signing* key — Play Console › App integrity › App signing —
# not the upload key's. Colon-separated hex; comma-separate several. Unset:
# /.well-known/assetlinks.json is 404.
ANDROID_CERT_FINGERPRINTS=
# Store listings, set once each is public. Unset hides the button.
STORE_URL_ANDROID=
STORE_URL_IOS=

# Heat notifications (docs/cloud.md), on every node. The key files go in the data
# volume; a platform left unconfigured offers its phones no bell. To create a key
# file, run the command, paste the file's content, then press Enter and Ctrl-D.

# iOS (APNs). Apple Developer › Certificates, IDs & Profiles › Keys › + › Apple Push
# Notifications service; the .p8 downloads once. The Key ID is shown there, the Team
# ID under Membership details.
#   docker compose exec -u 10001 app sh -c 'umask 077 && cat > /data/apns.p8'
# APNS_KEY_ID=
# APNS_TEAM_ID=
# APNS_TOPIC=app.splouch.ios
# APNS_KEY_FILE=/data/apns.p8

# Android (FCM). Firebase console › Project settings › Service accounts › Generate
# new private key.
#   docker compose exec -u 10001 app sh -c 'umask 077 && cat > /data/fcm.json'
# FCM_SERVICE_ACCOUNT_FILE=/data/fcm.json

# After changing any of these, from cloud/:
#   docker compose up -d
